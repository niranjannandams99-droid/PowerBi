        "measures": [
          {
            "name": "Total Orders",
            "expression": " COUNTROWS(Fact_Flipkart_Orders)"
          },
          {
            "name": "Total Sale",
            "expression": " SUM(Fact_Flipkart_Orders[Order_Value])"
          },
          {
            "name": "Delivered Orders",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Orders],",
              "    Fact_Flipkart_Orders[Status] = \"Delivered\"",
              ")"
            ]
          },
          {
            "name": "Cancelled Orders",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Orders],",
              "    Fact_Flipkart_Orders[Status] = \"Cancelled\"",
              ")"
            ]
          },
          {
            "name": "Average Delivery Days",
            "expression": [
              "",
              "AVERAGE(Fact_Flipkart_Orders[Actual_Days])"
            ]
          },
          {
            "name": "Average Promised Days",
            "expression": [
              "",
              "AVERAGE(Fact_Flipkart_Orders[Promised_Days])"
            ]
          },
          {
            "name": "SLA Breached Orders",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Orders],",
              "    Fact_Flipkart_Orders[SLA_Breached] = \"Yes\"",
              ")"
            ]
          },
          {
            "name": "SLA Breach %",
            "expression": [
              "",
              "DIVIDE(",
              "    [SLA Breached Orders],",
              "    [Total Orders],",
              "    0",
              ")"
            ]
          },
          {
            "name": "Express Orders",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Orders],",
              "    Fact_Flipkart_Orders[Delivery_Type] = \"Express\"",
              ")"
            ]
          },
          {
            "name": "Standard Orders",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Orders],",
              "    Fact_Flipkart_Orders[Delivery_Type] = \"Standard\"",
              ")"
            ]
          },
          {
            "name": "Within SLA Orders",
            "expression": [
              "",
              "CALCULATE(",
              "    [Total Orders],",
              "    Fact_Flipkart_Orders[SLA_Status] = \"Within SLA\"",
              ")"
            ]
          },
          {
            "name": "Within SLA %",
            "expression": [
              "",
              "DIVIDE(",
              "    [Within SLA Orders],",
              "    [Total Orders],",
              "    0",
              ")"
            ]
          },
          {
            "name": "Cancellation Rate",
            "expression": [
              "",
              "DIVIDE(",
              "    [Cancelled Orders],",
              "    [Total Orders],",
              "    0",
              ")"
            ]
          },
          {
            "name": "Average Order Value",
            "expression": " AVERAGE(Fact_Flipkart_Orders[Order_Value])"
          }
        ],
